*.exe
*.out
*.app

# Biblioteki dynamiczne i statyczne
*.dll
*.so
*.dylib
*.a
*.lib

# Pliki obiektów kompilacji pośredniej
*.o
*.obj
*.pch
*.gch

# Pliki zrzutu pamięci po awarii
*.stackdump
*.core

